# Address the app listens on (put a reverse proxy or cloudflared in front of it).
BIND=127.0.0.1:8080
# Public URL, no trailing slash. Used for OAuth redirects, CSRF origin checks and cache purges.
BASE_URL=https://decompilati.onl
# PostgreSQL connection (libpq key=value string or postgres:// URL). The default connects
# over the local Unix socket as the OS user, which needs no password.
DATABASE_URL=host=/run/postgresql dbname=decompsite
# Uploaded cover images live here.
DATA_DIR=/var/lib/decompsite

# GitHub OAuth app (https://github.com/settings/developers).
# Callback URL: $BASE_URL/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional token for server-side GitHub API calls (recent commits). Any token with
# public read access works; without one the 60 requests/hour anonymous limit applies.
GITHUB_API_TOKEN=

# GitHub App for decomp.dev-style imports of `*_report` workflow artifacts (optional).
# Webhook URL: $BASE_URL/api/github/webhook; permissions: Actions (read), Metadata (read);
# events: Workflow run.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY_FILE=

# Cloudflare API token with the "Zone > Cache Purge" permission, and the zone id.
# Without these, pages are sent with a 60 s edge TTL instead of being purged on change.
CF_API_TOKEN=
CF_ZONE_ID=

# Comma-separated GitHub logins with admin rights (spotlight, hide, ban).
ADMIN_LOGINS=
# Projects with a vote score at or below this are hidden from listings.
HIDE_THRESHOLD=-5
# Seconds to batch changes before purging Cloudflare.
PURGE_DEBOUNCE_SECS=10
RUST_LOG=info,tower_http=warn
