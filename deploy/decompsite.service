[Unit]
Description=decompilati.onl
After=network-online.target
Wants=network-online.target

[Service]
User=decompsite
Group=decompsite
EnvironmentFile=/etc/decompsite.env
ExecStart=/usr/local/bin/decompsite
Restart=on-failure
StateDirectory=decompsite
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/decompsite

[Install]
WantedBy=multi-user.target
